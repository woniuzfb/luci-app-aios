#!/usr/bin/utpl
{%
	"use strict";
	import { load_config } from "./common/config.mjs";
	const cfg = load_config();
	const tp = cfg.transparent_proxy || {};
	const port_start = int(tp.dnsmasq_port_start || 5350);
	const port_count = int(tp.dnsmasq_port_count || 3);
%}
# Generated by luci-app-aios
strict-order
server=/#/127.0.0.1#{{ port_start }}
{% for (let i = port_start; i <= port_start + port_count; i++): %}
server=127.0.0.1#{{ i }}
{% endfor %}
bogus-nxdomain=127.127.127.127
bogus-nxdomain=100::6c62:636f:656b:2164
