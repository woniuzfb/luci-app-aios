#!/bin/sh

. /usr/share/libubox/jshn.sh

NAME=aios
PRESETS_DIR=/etc/aios/presets
RUNTIME_DIR=/var/etc/aios
PERSIST_DIR=/etc/aios
PID_FILE=/var/run/aios.main.pid
LOOPBACK_ADDR=127.0.0.1

uci_get() {
	local ret
	ret="$(uci -q get "${NAME}.${1}" 2>/dev/null)"
	echo "${ret:-$2}"
}

detect_core_type() {
	local configured="$1"
	local bin="$2"
	if [ "$configured" = "xray" ] || [ "$configured" = "v2ray" ]; then
		echo "$configured"
		return 0
	fi
	local ver
	ver="$("$bin" version 2>/dev/null | head -n 1)"
	case "$ver" in
		*[Xx]ray*) echo "xray" ;;
		*V2Ray*|*v2ray*) echo "v2ray" ;;
		*)
			case "$(basename "$bin")" in
				*xray*) echo "xray" ;;
				*) echo "v2ray" ;;
			esac
			;;
	esac
}

detect_fw_backend() {
	local configured
	configured="$(uci_get main_tproxy.firewall_backend auto)"
	if [ "$configured" = "nftables" ] || [ "$configured" = "iptables" ] || [ "$configured" = "none" ]; then
		echo "$configured"
		return 0
	fi
	if command -v fw4 >/dev/null 2>&1 && command -v nft >/dev/null 2>&1; then
		echo "nftables"
	elif command -v iptables >/dev/null 2>&1 && command -v ipset >/dev/null 2>&1; then
		echo "iptables"
	else
		echo "none"
	fi
}

sanitize_id() {
	echo "$1" | tr -cd 'a-zA-Z0-9_-' | cut -c1-64
}

resolve_core_bin() {
	local pref="${1:-}" bin configured cand cands fallback
	if [ -z "$pref" ] || [ "$pref" = "auto" ]; then
		bin="$(uci_get main.core_bin '')"
		if [ -n "$bin" ]; then
			echo "$bin"
			return 0
		fi
	fi
	configured="${pref:-$(uci_get main.core_type auto)}"
	case "$configured" in
		v2ray)
			cands="/usr/bin/aios-v2ray /usr/bin/v2ray /usr/bin/aios-xray /usr/bin/xray"
			fallback="/usr/bin/aios-v2ray"
			;;
		xray)
			cands="/usr/bin/aios-xray /usr/bin/xray /usr/bin/aios-v2ray /usr/bin/v2ray"
			fallback="/usr/bin/aios-xray"
			;;
		*)
			cands="/usr/bin/aios-xray /usr/bin/aios-v2ray /usr/bin/xray /usr/bin/v2ray"
			fallback="/usr/bin/aios-xray"
			;;
	esac
	for cand in $cands; do
		if [ -x "$cand" ]; then
			echo "$cand"
			return 0
		fi
	done
	echo "$fallback"
}

resolve_asset_dir() {
	local asset cand
	asset="$(uci_get main.asset_location '')"
	if [ -n "$asset" ]; then
		echo "$asset"
		return 0
	fi
	for cand in /usr/share/aios/geodata /usr/share/xray /usr/share/v2ray; do
		if [ -d "$cand" ]; then
			echo "$cand"
			return 0
		fi
	done
	echo "/usr/share/aios/geodata"
}

rpc_core_info() {
	local bin configured core_type ver core_version asset has_geoip has_geosite has_ucode fw_backend
	bin="$(resolve_core_bin)"
	configured="$(uci_get main.core_type auto)"
	asset="$(resolve_asset_dir)"
	ver=""
	core_version=""
	if [ -x "$bin" ]; then
		ver="$("$bin" version 2>/dev/null | head -n 1)"
		core_version="$(printf '%s\n' "$ver" | sed -nE 's/.*[[:space:]]([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)"
		core_type="$(detect_core_type "$configured" "$bin")"
	else
		core_type="$configured"
	fi
	[ -f "${asset}/geoip.dat" ] && has_geoip=1 || has_geoip=0
	[ -f "${asset}/geosite.dat" ] && has_geosite=1 || has_geosite=0
	command -v ucode >/dev/null 2>&1 && has_ucode=1 || has_ucode=0
	fw_backend="$(detect_fw_backend)"

	json_init
	json_add_string "core_bin" "$bin"
	json_add_boolean "binary_exists" "$([ -x "$bin" ] && echo 1 || echo 0)"
	json_add_string "core_type" "$core_type"
	json_add_string "version" "$ver"
	json_add_string "core_version" "$core_version"
	json_add_string "asset_location" "$asset"
	json_add_boolean "has_geoip" "$has_geoip"
	json_add_boolean "has_geosite" "$has_geosite"
	json_add_boolean "has_ucode" "$has_ucode"
	json_add_string "detected_firewall" "$fw_backend"
	json_dump
}

rpc_service_status() {
	local running=0 pid="" rss_kb=0
	if [ -s "$PID_FILE" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if [ -n "$pid" ] && [ -d "/proc/${pid}" ]; then
			running=1
			rss_kb="$(awk '/VmRSS/ {print $2}' "/proc/${pid}/status" 2>/dev/null)"
		fi
	fi
	json_init
	json_add_boolean "running" "$running"
	json_add_string "pid" "$pid"
	json_add_int "rss_kb" "${rss_kb:-0}"
	json_dump
}

rpc_preflight_check() {
	local table mark aios_pid svc p cmd arg0 base line
	local svc_list="" proc_list="" fw_list=""
	table="$(uci_get main_tproxy.route_table 166)"
	mark="$(uci_get main_tproxy.tproxy_mark 0x3a01)"
	aios_pid=""
	[ -s "$PID_FILE" ] && aios_pid="$(cat "$PID_FILE" 2>/dev/null)"

	for svc in xray xray_core v2ray passwall passwall2 openclash homeproxy shadowsocksr sing-box v2raya; do
		if [ -x "/etc/init.d/${svc}" ] && /etc/init.d/"${svc}" running >/dev/null 2>&1; then
			svc_list="${svc_list}${svc}
"
		fi
	done

	for p in /proc/[0-9]*; do
		p="${p#/proc/}"
		[ "$p" = "$aios_pid" ] && continue
		[ -r "/proc/${p}/cmdline" ] || continue
		cmd="$(tr '\0' ' ' < "/proc/${p}/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//')"
		[ -n "$cmd" ] || continue
		arg0="${cmd%% *}"
		base="$(basename "$arg0" 2>/dev/null)"
		case "$base" in
			xray|v2ray|aios-xray|aios-v2ray)
				proc_list="${proc_list}PID ${p}: ${cmd}
"
				;;
		esac
	done

	if command -v nft >/dev/null 2>&1; then
		local nft_hits
		nft_hits="$(nft list ruleset 2>/dev/null | awk '
			/^table / { tbl=$2 " " $3; in_aios=(tbl == "inet aios"); next }
			!in_aios && /(tproxy (to|ip|ip6)|redirect to :)/ { if (tbl != "" && !seen[tbl]++) print "nftables: table " tbl " (存在第三方 tproxy/redirect 规则)" }
		')"
		[ -n "$nft_hits" ] && fw_list="${fw_list}${nft_hits}
"
	fi

	if command -v iptables-save >/dev/null 2>&1; then
		local ipt_hits
		ipt_hits="$(iptables-save 2>/dev/null | awk '
			/^-A / && ($0 ~ /-j TPROXY/ || $0 ~ /-j REDIRECT/) && $2 !~ /^AIOS_/ {
				if (!seen[$2]++) print "iptables: chain " $2 " (存在第三方 TPROXY/REDIRECT 规则)"
			}
		')"
		[ -n "$ipt_hits" ] && fw_list="${fw_list}${ipt_hits}
"
	fi

	local old_ifs="$IFS"
	set -f
	IFS='
'
	json_init
	json_add_array "warnings"
	for line in $svc_list; do
		[ -n "$line" ] && json_add_string "" "检测到共存代理服务正在运行: ${line}"
	done
	for line in $proc_list; do
		[ -n "$line" ] && json_add_string "" "检测到外部内核进程: ${line}"
	done
	for line in $fw_list; do
		[ -n "$line" ] && json_add_string "" "检测到第三方透明代理防火墙规则: ${line}"
	done
	if ip rule show 2>/dev/null | grep -Eq "lookup ${table}([[:space:]]|$)"; then
		if [ ! -f "${RUNTIME_DIR}/aios_active" ]; then
			json_add_string "" "路由表 ${table} 已被其他 ip rule 占用"
		fi
	fi
	json_close_array

	json_add_array "conflicting_services"
	for line in $svc_list; do
		[ -n "$line" ] && json_add_string "" "$line"
	done
	json_close_array

	json_add_array "external_processes"
	for line in $proc_list; do
		[ -n "$line" ] && json_add_string "" "$line"
	done
	json_close_array

	json_add_array "firewall_conflicts"
	for line in $fw_list; do
		[ -n "$line" ] && json_add_string "" "$line"
	done
	json_close_array
	IFS="$old_ifs"
	set +f

	json_add_string "route_table" "$table"
	json_add_string "tproxy_mark" "$mark"
	json_dump
}

rpc_firewall_inspect() {
	local backend active table_present route_table tproxy_mark
	local live_rules ip_rules ip_routes rendered_file dd_v4_cnt dd_v6_cnt
	backend="$(detect_fw_backend)"
	[ -f "${RUNTIME_DIR}/aios_active" ] && active=1 || active=0
	route_table="$(uci_get main_tproxy.route_table 166)"
	tproxy_mark="$(uci_get main_tproxy.tproxy_mark 0x3a01)"
	table_present=0
	live_rules=""
	dd_v4_cnt=0
	dd_v6_cnt=0

	if [ "$backend" = "nftables" ] && command -v nft >/dev/null 2>&1; then
		if nft list table inet aios >/dev/null 2>&1; then
			table_present=1
			live_rules="$(nft list table inet aios 2>/dev/null)"
			dd_v4_cnt="$(nft list set inet aios aios_dd_v4 2>/dev/null | grep -c 'timeout' || true)"
			dd_v6_cnt="$(nft list set inet aios aios_dd_v6 2>/dev/null | grep -c 'timeout' || true)"
		fi
	elif [ "$backend" = "iptables" ] && command -v iptables >/dev/null 2>&1; then
		if iptables -t mangle -L AIOS_PREROUTING -n >/dev/null 2>&1 || iptables -t nat -L AIOS_REDIRECT -n >/dev/null 2>&1; then
			table_present=1
			live_rules="$(
				echo "=== iptables -t mangle (AIOS_*) ==="
				iptables -t mangle -L AIOS_PREROUTING -v -n 2>/dev/null
				iptables -t mangle -L AIOS_OUTPUT -v -n 2>/dev/null
				echo "=== iptables -t nat (AIOS_REDIRECT) ==="
				iptables -t nat -L AIOS_REDIRECT -v -n 2>/dev/null
				echo "=== ipset (aios_*) ==="
				ipset list -t 2>/dev/null | grep -A 5 '^Name: aios_'
			)"
		fi
	fi

	ip_rules="$(ip rule show 2>/dev/null; echo "--- IPv6 ---"; ip -6 rule show 2>/dev/null)"
	ip_routes="$(ip route show table "$route_table" 2>/dev/null; echo "--- IPv6 ---"; ip -6 route show table "$route_table" 2>/dev/null)"
	rendered_file=""
	[ -r "${RUNTIME_DIR}/fw4_01_aios.nft" ] && rendered_file="$(cat "${RUNTIME_DIR}/fw4_01_aios.nft")"

	json_init
	json_add_string "backend" "$backend"
	json_add_boolean "active" "$active"
	json_add_boolean "table_present" "$table_present"
	json_add_string "route_table" "$route_table"
	json_add_string "tproxy_mark" "$tproxy_mark"
	json_add_int "dynamic_direct_v4_count" "${dd_v4_cnt:-0}"
	json_add_int "dynamic_direct_v6_count" "${dd_v6_cnt:-0}"
	json_add_string "live_rules" "$live_rules"
	json_add_string "rendered_file" "$rendered_file"
	json_add_string "ip_rules" "$ip_rules"
	json_add_string "ip_routes" "$ip_routes"
	json_dump
}

rpc_firewall_action() {
	local input action backend mark table mode err
	local route_state="${RUNTIME_DIR}/last_route_state"
	read -r input
	json_load "$input"
	json_get_var action "action"
	backend="$(detect_fw_backend)"
	mode="$(uci_get main_tproxy.tproxy_mode tproxy)"
	mark="$(uci_get main_tproxy.tproxy_mark 0x3a01)"
	table="$(uci_get main_tproxy.route_table 166)"

	case "$action" in
		apply)
			mkdir -p "$RUNTIME_DIR"
			if [ "$backend" = "nftables" ] && command -v nft >/dev/null 2>&1; then
				# Always flush previous policy routing first (including when switching to redirect)
				ip rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
				ip route del local default dev lo table "$table" 2>/dev/null || true
				ip -6 rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
				ip -6 route del local default dev lo table "$table" 2>/dev/null || true
				if [ -s "$route_state" ]; then
					local pm pt
					read -r pm pt < "$route_state" 2>/dev/null || true
					if [ -n "$pm" ] && [ -n "$pt" ]; then
						ip rule del fwmark "$pm" lookup "$pt" 2>/dev/null || true
						ip route del local default dev lo table "$pt" 2>/dev/null || true
						ip -6 rule del fwmark "$pm" lookup "$pt" 2>/dev/null || true
						ip -6 route del local default dev lo table "$pt" 2>/dev/null || true
					fi
					rm -f "$route_state"
				fi
				if [ "$mode" != "redirect" ]; then
					printf '%s %s\n' "$mark" "$table" > "$route_state"
					if ! err="$(ip rule add fwmark "$mark" lookup "$table" 2>&1 && ip route add local default dev lo table "$table" 2>&1)"; then
						json_init; json_add_boolean "ok" 0; json_add_string "error" "IPv4 policy routing failed: ${err}"; json_dump; return
					fi
					ip -6 rule add fwmark "$mark" lookup "$table" 2>/dev/null || true
					ip -6 route add local default dev lo table "$table" 2>/dev/null || true
				fi
				if ! err="$(/usr/bin/utpl /usr/share/aios/firewall/fw4_nft.ut 2>&1 > "${RUNTIME_DIR}/fw4_01_aios.nft.tmp")"; then
					rm -f "${RUNTIME_DIR}/fw4_01_aios.nft.tmp"
					json_init; json_add_boolean "ok" 0; json_add_string "error" "utpl render failed: ${err}"; json_dump; return
				fi
				mv -f "${RUNTIME_DIR}/fw4_01_aios.nft.tmp" "${RUNTIME_DIR}/fw4_01_aios.nft"
				nft delete table inet aios 2>/dev/null || true
				if ! err="$(nft -f "${RUNTIME_DIR}/fw4_01_aios.nft" 2>&1)"; then
					json_init; json_add_boolean "ok" 0; json_add_string "error" "nft apply failed: ${err}"; json_dump; return
				fi
				[ -x /usr/share/aios/firewall/gateway.uc ] && /usr/bin/ucode /usr/share/aios/firewall/gateway.uc >/dev/null 2>&1 || true
			elif [ "$backend" = "iptables" ] && [ -x /usr/share/aios/firewall/fw3_ipt.sh ]; then
				if ! err="$(/usr/share/aios/firewall/fw3_ipt.sh restart 2>&1)"; then
					json_init; json_add_boolean "ok" 0; json_add_string "error" "fw3_ipt.sh failed: ${err}"; json_dump; return
				fi
			fi
			json_init
			json_add_boolean "ok" 1
			json_add_string "action" "apply"
			json_add_string "backend" "$backend"
			json_dump
			;;
		flush)
			ip rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
			ip route del local default dev lo table "$table" 2>/dev/null || true
			ip -6 rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
			ip -6 route del local default dev lo table "$table" 2>/dev/null || true
			if [ -s "$route_state" ]; then
				local pm pt
				read -r pm pt < "$route_state" 2>/dev/null || true
				if [ -n "$pm" ] && [ -n "$pt" ]; then
					ip rule del fwmark "$pm" lookup "$pt" 2>/dev/null || true
					ip route del local default dev lo table "$pt" 2>/dev/null || true
					ip -6 rule del fwmark "$pm" lookup "$pt" 2>/dev/null || true
					ip -6 route del local default dev lo table "$pt" 2>/dev/null || true
				fi
				rm -f "$route_state"
			fi
			command -v nft >/dev/null 2>&1 && nft delete table inet aios 2>/dev/null || true
			[ -x /usr/share/aios/firewall/fw3_ipt.sh ] && /usr/share/aios/firewall/fw3_ipt.sh stop >/dev/null 2>&1 || true
			rm -f "${RUNTIME_DIR}"/fw4_*.nft
			json_init
			json_add_boolean "ok" 1
			json_add_string "action" "flush"
			json_add_string "backend" "$backend"
			json_dump
			;;
		refresh_gateway)
			if command -v ucode >/dev/null 2>&1 && [ -x /usr/share/aios/firewall/gateway.uc ]; then
				if ! err="$(/usr/bin/ucode /usr/share/aios/firewall/gateway.uc 2>&1)"; then
					json_init; json_add_boolean "ok" 0; json_add_string "error" "gateway.uc failed: ${err}"; json_dump; return
				fi
			fi
			echo '{"ok":true,"action":"refresh_gateway"}'
			;;
		*)
			echo '{"ok":false,"error":"unsupported firewall action"}'
			;;
	esac
}

rpc_validate_config() {
	local input config_json req_core_type req_fmt req_bin bin core_type fmt asset tmp out code
	read -r input
	json_load "$input"
	json_get_var config_json "config"
	json_get_var req_core_type "core_type"
	json_get_var req_fmt "v2ray_format"
	json_get_var req_bin "core_bin"

	bin=""
	if [ -n "$req_bin" ] && is_allowed_core_bin "$req_bin" "$(uci_get main.bins_dir '')"; then
		bin="$req_bin"
	fi
	[ -n "$bin" ] || bin="$(resolve_core_bin "$req_core_type")"
	core_type="$(detect_core_type "${req_core_type:-$(uci_get main.core_type auto)}" "$bin")"
	fmt="${req_fmt:-$(uci_get main.v2ray_format jsonv4)}"
	asset="$(resolve_asset_dir)"

	if [ ! -x "$bin" ]; then
		json_init
		json_add_boolean "ok" 0
		json_add_string "output" "Core binary not executable: ${bin}"
		json_dump
		return
	fi

	tmp="${RUNTIME_DIR}/validate.$$.json"
	mkdir -p "$RUNTIME_DIR"
	if [ -n "$config_json" ]; then
		printf '%s\n' "$config_json" > "$tmp"
	elif [ -s "${RUNTIME_DIR}/config.json" ]; then
		cp -f "${RUNTIME_DIR}/config.json" "$tmp"
	else
		json_init
		json_add_boolean "ok" 0
		json_add_string "output" "No configuration provided or generated"
		json_dump
		return
	fi

	if [ "$core_type" = "xray" ]; then
		out="$(XRAY_LOCATION_ASSET="$asset" "$bin" run -test -c "$tmp" 2>&1)"
		code=$?
	else
		if [ "$fmt" = "jsonv5" ]; then
			out="$(V2RAY_LOCATION_ASSET="$asset" "$bin" test -c "$tmp" -format jsonv5 2>&1)"
		else
			out="$(V2RAY_LOCATION_ASSET="$asset" "$bin" test -c "$tmp" 2>&1)"
		fi
		code=$?
	fi
	rm -f "$tmp"

	json_init
	json_add_boolean "ok" "$([ "$code" -eq 0 ] && echo 1 || echo 0)"
	json_add_string "output" "$out"
	json_dump
}

rpc_stats() {
	local bin core_type metrics_port api_port out
	bin="$(resolve_core_bin)"
	core_type="$(detect_core_type "$(uci_get main.core_type auto)" "$bin")"
	metrics_port="$(uci_get main.metrics_port 18888)"
	api_port="$(uci_get main.api_port 18080)"

	if [ "$core_type" = "xray" ] && [ "$(uci_get main.metrics_enabled 1)" = "1" ]; then
		if command -v wget >/dev/null 2>&1; then
			local url="http://${LOOPBACK_ADDR}:${metrics_port}/debug/vars"
			out="$(wget -qO- -T 2 "$url" 2>/dev/null)"
			if [ -n "$out" ] && jshn -r "$out" >/dev/null 2>&1; then
				printf '{"source":"metrics","core":"xray","data":%s}\n' "$out"
				return
			fi
		fi
	fi

	if [ -x "$bin" ]; then
		out="$("$bin" api statsquery --server="${LOOPBACK_ADDR}:${api_port}" 2>/dev/null)"
		if [ -n "$out" ]; then
			if jshn -r "$out" >/dev/null 2>&1; then
				printf '{"source":"api","core":"%s","data":%s}\n' "$core_type" "$out"
			else
				json_init
				json_add_string "source" "api"
				json_add_string "core" "$core_type"
				json_add_object "data"
				json_add_string "raw" "$out"
				json_close_object
				json_dump
			fi
			return
		fi
	fi

	printf '{"source":"none","core":"%s","data":{}}\n' "$core_type"
}

rpc_key_gen() {
	local input kind bin out
	read -r input
	json_load "$input"
	json_get_var kind "kind"
	bin="$(resolve_core_bin)"
	out=""
	if [ -x "$bin" ]; then
		case "$kind" in
			uuid) out="$("$bin" uuid 2>/dev/null)" ;;
			x25519) out="$("$bin" x25519 2>/dev/null)" ;;
			mldsa65) out="$("$bin" mldsa65 2>/dev/null)" ;;
			vlessenc) out="$("$bin" vlessenc 2>/dev/null)" ;;
			wg) out="$("$bin" wg 2>/dev/null)" ;;
		esac
	fi
	json_init
	json_add_string "kind" "$kind"
	json_add_string "output" "$out"
	json_dump
}

rpc_list_presets() {
	mkdir -p "$PRESETS_DIR"
	printf '{"presets":['
	local first=1 f
	for f in "${PRESETS_DIR}"/*.json; do
		[ -s "$f" ] || continue
		jshn -R "$f" >/dev/null 2>&1 || continue
		[ "$first" = "0" ] && printf ','
		first=0
		cat "$f"
	done
	printf ']}\n'
}

rpc_save_preset() {
	local input id payload safe_id
	read -r input
	json_load "$input"
	json_get_var id "id"
	json_get_var payload "payload"
	safe_id="$(sanitize_id "$id")"
	if [ -z "$safe_id" ] || [ -z "$payload" ]; then
		echo '{"ok":false,"error":"invalid id or payload"}'
		return
	fi
	if ! jshn -r "$payload" >/dev/null 2>&1; then
		echo '{"ok":false,"error":"preset payload is not valid JSON"}'
		return
	fi
	mkdir -p "$PRESETS_DIR"
	printf '%s\n' "$payload" > "${PRESETS_DIR}/${safe_id}.json.tmp"
	mv -f "${PRESETS_DIR}/${safe_id}.json.tmp" "${PRESETS_DIR}/${safe_id}.json"
	printf '{"ok":true,"id":"%s"}\n' "$safe_id"
}

rpc_delete_preset() {
	local input id safe_id
	read -r input
	json_load "$input"
	json_get_var id "id"
	safe_id="$(sanitize_id "$id")"
	[ -z "$safe_id" ] && { echo '{"ok":false,"error":"invalid id"}'; return; }
	rm -f "${PRESETS_DIR}/${safe_id}.json"
	printf '{"ok":true,"id":"%s"}\n' "$safe_id"
}

rpc_write_compiled_config() {
	local input content
	read -r input
	json_load "$input"
	json_get_var content "content"
	[ -z "$content" ] && { echo '{"ok":false,"error":"empty content"}'; return; }
	mkdir -p "$PERSIST_DIR"
	printf '%s\n' "$content" > "${PERSIST_DIR}/compiled.json"
	echo '{"ok":true}'
}

rpc_read_compiled_config() {
	local src="${RUNTIME_DIR}/config.json"
	[ -s "$src" ] || src="${PERSIST_DIR}/compiled.json"
	json_init
	if [ -s "$src" ]; then
		json_add_string "path" "$src"
		json_add_string "content" "$(cat "$src")"
	else
		json_add_string "path" ""
		json_add_string "content" ""
	fi
	json_dump
}

rpc_read_log() {
	local log_file out
	log_file="$(uci_get main.error_log /var/log/aios-error.log)"
	if [ -r "$log_file" ] && [ "$log_file" != "none" ] && [ "$log_file" != "/dev/null" ]; then
		out="$(tail -n 200 "$log_file" 2>/dev/null)"
	else
		out="$(logread -e aios 2>/dev/null | tail -n 200)"
	fi
	json_init
	json_add_string "content" "$out"
	json_dump
}

rpc_service_action() {
	local input action out code
	read -r input
	json_load "$input"
	json_get_var action "action"
	case "$action" in
		start)
			out="$(/etc/init.d/aios start_manual 2>&1)"
			code=$?
			;;
		restart|reload)
			out="$(FORCE_START=1 /etc/init.d/aios "$action" 2>&1)"
			code=$?
			;;
		stop)
			out="$(/etc/init.d/aios stop 2>&1)"
			code=$?
			;;
		*)
			echo '{"ok":false,"error":"unsupported action"}'
			return
			;;
	esac
	json_init
	if [ "$code" -eq 0 ]; then
		json_add_boolean "ok" 1
		json_add_string "action" "$action"
	else
		json_add_boolean "ok" 0
		json_add_string "action" "$action"
		json_add_string "error" "${out:-service action failed (exit ${code})}"
	fi
	json_dump
}

rpc_list_cores() {
	local bins_dir active_bin active_real avail_kb has_unzip has_sha256 has_dl
	bins_dir="$(uci_get main.bins_dir '')"
	active_bin="$(resolve_core_bin)"
	[ -x "$active_bin" ] || active_bin=""
	active_real="$active_bin"
	[ -L "$active_bin" ] && active_real="$(readlink -f "$active_bin" 2>/dev/null || echo "$active_bin")"

	avail_kb=0
	if [ -n "$bins_dir" ]; then
		local probe_dir="$bins_dir"
		while [ -n "$probe_dir" ] && [ ! -d "$probe_dir" ] && [ "$probe_dir" != "/" ]; do
			probe_dir="$(dirname "$probe_dir")"
		done
		[ -d "$probe_dir" ] || probe_dir="/"
		avail_kb="$(df -Pk "$probe_dir" 2>/dev/null | awk 'NR>1 {val=$(NF-2)} END {print val+0}')"
		avail_kb="${avail_kb:-0}"
	fi
	has_unzip=0; command -v unzip >/dev/null 2>&1 && has_unzip=1
	has_sha256=0; command -v sha256sum >/dev/null 2>&1 && has_sha256=1
	has_dl=0; (command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1) && has_dl=1

	json_init
	json_add_string "bins_dir" "$bins_dir"
	json_add_string "active_bin" "$active_bin"
	json_add_string "active_real" "$active_real"
	json_add_string "arch" "$(uname -m 2>/dev/null || echo unknown)"
	json_add_int "avail_kb" "${avail_kb:-0}"
	json_add_boolean "has_unzip" "$has_unzip"
	json_add_boolean "has_sha256" "$has_sha256"
	json_add_boolean "has_downloader" "$has_dl"

	json_add_array "slots"
	local cand ver cver ctype is_active
	for cand in /usr/bin/aios-xray /usr/bin/aios-v2ray /usr/bin/xray /usr/bin/v2ray; do
		if [ -x "$cand" ]; then
			ver="$("$cand" version 2>/dev/null | head -n 1)"
			cver="$(printf '%s\n' "$ver" | sed -nE 's/.*[[:space:]]([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)"
			ctype="$(detect_core_type auto "$cand")"
			is_active=0
			[ "$cand" = "$active_bin" ] || [ "$cand" = "$active_real" ] && is_active=1
			json_add_object ""
			json_add_string "id" "system:$(basename "$cand")"
			json_add_string "source" "system"
			json_add_string "core" "$ctype"
			json_add_string "tag" "system"
			json_add_string "version" "${cver:-unknown}"
			json_add_string "path" "$cand"
			json_add_boolean "active" "$is_active"
			json_add_boolean "removable" 0
			json_close_object
		fi
	done

	if [ -n "$bins_dir" ] && [ -d "$bins_dir" ]; then
		local entry slot_name bin_path
		for entry in "$bins_dir"/*; do
			[ -d "$entry" ] || continue
			slot_name="$(basename "$entry")"
			case "$slot_name" in
				.*|current) continue ;;
			esac
			bin_path=""
			if [ -x "${entry}/xray" ]; then
				bin_path="${entry}/xray"
			elif [ -x "${entry}/v2ray" ]; then
				bin_path="${entry}/v2ray"
			else
				continue
			fi
			ver="$("$bin_path" version 2>/dev/null | head -n 1)"
			cver="$(printf '%s\n' "$ver" | sed -nE 's/.*[[:space:]]([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)"
			ctype="$(detect_core_type auto "$bin_path")"
			is_active=0
			[ "$bin_path" = "$active_bin" ] || [ "$bin_path" = "$active_real" ] && is_active=1
			json_add_object ""
			json_add_string "id" "$slot_name"
			json_add_string "source" "managed"
			json_add_string "core" "$ctype"
			json_add_string "tag" "${slot_name#*-}"
			json_add_string "version" "${cver:-unknown}"
			json_add_string "path" "$bin_path"
			json_add_boolean "active" "$is_active"
			json_add_boolean "removable" "$([ "$is_active" = "1" ] && echo 0 || echo 1)"
			json_close_object
		done
	fi
	json_close_array
	json_dump
}

is_allowed_core_bin() {
	local cand="$1" bins_dir="$2"
	[ -n "$cand" ] && [ -x "$cand" ] || return 1
	case "$cand" in
		/usr/bin/aios-xray|/usr/bin/aios-v2ray|/usr/bin/xray|/usr/bin/v2ray)
			return 0
			;;
	esac
	local real_cand real_bins rel slot leaf
	real_cand="$(readlink -f "$cand" 2>/dev/null || echo "")"
	[ -n "$real_cand" ] && [ -x "$real_cand" ] || return 1
	case "$real_cand" in
		/usr/bin/aios-xray|/usr/bin/aios-v2ray|/usr/bin/xray|/usr/bin/v2ray)
			return 0
			;;
	esac
	[ -n "$bins_dir" ] && [ -d "$bins_dir" ] || return 1
	real_bins="$(readlink -f "$bins_dir" 2>/dev/null || echo "$bins_dir")"
	case "$real_cand" in
		"${real_bins}/"*)
			rel="${real_cand#"${real_bins}/"}"
			slot="${rel%%/*}"
			leaf="${rel#*/}"
			if [ "$leaf" != "xray" ] && [ "$leaf" != "v2ray" ]; then
				return 1
			fi
			if [ -z "$slot" ] || [ "$slot" = "." ] || [ "$slot" = ".." ] || [ "$slot" = "current" ]; then
				return 1
			fi
			printf '%s\n' "$slot" | grep -qE '^[a-zA-Z0-9._-]+$' || return 1
			[ "$real_cand" = "${real_bins}/${slot}/${leaf}" ] && return 0
			;;
	esac
	return 1
}

rpc_install_core() {
	local input core tag mirror bins_dir job_id
	read -r input
	json_load "$input"
	json_get_var core "core"
	json_get_var tag "tag"
	json_get_var mirror "mirror"
	bins_dir="$(uci_get main.bins_dir '')"
	if [ -z "$bins_dir" ]; then
		echo '{"ok":false,"error":"bins_dir is not configured in UCI (main.bins_dir)"}'
		return 0
	fi
	if [ "$core" != "xray" ] && [ "$core" != "v2ray" ]; then
		echo '{"ok":false,"error":"core must be xray or v2ray"}'
		return 0
	fi
	if [ -z "$tag" ] || [ "$tag" = "." ] || [ "$tag" = ".." ] || ! printf '%s\n' "$tag" | grep -qE '^[a-zA-Z0-9._-]+$'; then
		echo '{"ok":false,"error":"invalid version tag"}'
		return 0
	fi
	if [ -n "$mirror" ]; then
		if ! printf '%s\n' "$mirror" | grep -qE '^https?://[^[:space:]]+$'; then
			echo '{"ok":false,"error":"invalid mirror URL (must start with http:// or https://)"}'
			return 0
		fi
		case "$mirror" in
			*/) ;;
			*) mirror="${mirror}/" ;;
		esac
	fi
	if [ -d /var/lock/aios-install.lock ]; then
		if [ -s /var/lock/aios-install.lock/pid ]; then
			local lock_pid
			lock_pid="$(cat /var/lock/aios-install.lock/pid 2>/dev/null || true)"
			if [ -n "$lock_pid" ] && [ ! -d "/proc/${lock_pid}" ]; then
				rm -rf /var/lock/aios-install.lock 2>/dev/null || true
			fi
		fi
		if [ -d /var/lock/aios-install.lock ]; then
			echo '{"ok":false,"error":"another install job is already running"}'
			return 0
		fi
	fi
	job_id="$(date +%s)-$$"
	mkdir -p "$RUNTIME_DIR"
	printf '{"job_id":"%s","state":"queued","core":"%s","tag":"%s","progress":5,"message":"Queued install","updated_at":%s}\n' \
		"$job_id" "$core" "$tag" "$(date +%s)" > "${RUNTIME_DIR}/install.status"
	/usr/share/aios/core_manager.sh install "$core" "$tag" "$bins_dir" "${mirror:-}" "$job_id" </dev/null >/dev/null 2>&1 &
	printf '{"ok":true,"job_id":"%s"}\n' "$job_id"
}

rpc_install_status() {
	if [ -s "${RUNTIME_DIR}/install.status" ]; then
		cat "${RUNTIME_DIR}/install.status"
	else
		echo '{"state":"idle","progress":0,"message":""}'
	fi
}

rpc_switch_core() {
	local input target_bin compiled_json bins_dir tmp_json=""
	read -r input
	json_load "$input"
	json_get_var target_bin "path"
	json_get_var compiled_json "compiled_json"
	bins_dir="$(uci_get main.bins_dir '')"
	if ! is_allowed_core_bin "$target_bin" "$bins_dir"; then
		echo '{"ok":false,"error":"Target binary path is not in allowed whitelist or not executable"}'
		return 0
	fi
	mkdir -p "$RUNTIME_DIR"
	if [ -n "$compiled_json" ]; then
		tmp_json="${RUNTIME_DIR}/switch_precompiled.json"
		printf '%s' "$compiled_json" > "$tmp_json"
	fi
	/usr/share/aios/core_manager.sh switch "$target_bin" "$tmp_json"
	[ -n "$tmp_json" ] && rm -f "$tmp_json"
}

rpc_remove_core() {
	local input slot_id bins_dir target_dir active_bin active_real
	read -r input
	json_load "$input"
	json_get_var slot_id "id"
	bins_dir="$(uci_get main.bins_dir '')"
	if [ -z "$bins_dir" ] || [ -z "$slot_id" ]; then
		echo '{"ok":false,"error":"bins_dir or slot id missing"}'
		return 0
	fi
	if ! printf '%s\n' "$slot_id" | grep -qE '^[a-zA-Z0-9._-]+$' || [ "$slot_id" = "." ] || [ "$slot_id" = ".." ] || [ "$slot_id" = "current" ]; then
		echo '{"ok":false,"error":"invalid slot id"}'
		return 0
	fi
	target_dir="${bins_dir}/${slot_id}"
	if [ ! -d "$target_dir" ]; then
		echo '{"ok":false,"error":"slot not found"}'
		return 0
	fi
	local real_target_dir
	real_target_dir="$(readlink -f "$target_dir" 2>/dev/null || echo "$target_dir")"
	active_bin="$(resolve_core_bin)"
	active_real="$(readlink -f "$active_bin" 2>/dev/null || echo "$active_bin")"
	case "$active_real" in
		"${real_target_dir}"/*)
			echo '{"ok":false,"error":"cannot remove currently active core slot"}'
			return 0
			;;
	esac
	rm -rf "$target_dir"
	printf '{"ok":true,"id":"%s"}\n' "$slot_id"
}

rpc_stop_conflicting_services() {
	local input services_csv old_ifs svc
	read -r input
	json_load "$input"
	json_get_var services_csv "services"

	json_init
	json_add_boolean "ok" 1
	json_add_array "stopped"
	old_ifs="$IFS"
	IFS=','
	for svc in $services_csv; do
		IFS="$old_ifs"
		svc="$(printf '%s' "$svc" | tr -cd 'a-zA-Z0-9_-')"
		case "$svc" in
			xray|xray_core|v2ray|passwall|passwall2|openclash|homeproxy|shadowsocksr|sing-box|v2raya)
				if [ -x "/etc/init.d/${svc}" ]; then
					/etc/init.d/"${svc}" stop >/dev/null 2>&1 || true
					json_add_string "" "$svc"
				fi
				;;
		esac
		IFS=','
	done
	IFS="$old_ifs"
	json_close_array
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"coreInfo":{},"serviceStatus":{},"preflightCheck":{},"firewallInspect":{},"firewallAction":{"action":"String"},"validateConfig":{"config":"String","core_type":"String","v2ray_format":"String","core_bin":"String"},"stats":{},"keyGen":{"kind":"String"},"listPresets":{},"savePreset":{"id":"String","payload":"String"},"deletePreset":{"id":"String"},"writeCompiledConfig":{"content":"String"},"readCompiledConfig":{},"readLog":{},"serviceAction":{"action":"String"},"listCores":{},"installCore":{"core":"String","tag":"String","mirror":"String"},"installStatus":{},"switchCore":{"path":"String","compiled_json":"String"},"removeCore":{"id":"String"},"stopConflictingServices":{"services":"String"}}'
		;;
	call)
		case "$2" in
			coreInfo) rpc_core_info ;;
			serviceStatus) rpc_service_status ;;
			preflightCheck) rpc_preflight_check ;;
			firewallInspect) rpc_firewall_inspect ;;
			firewallAction) rpc_firewall_action ;;
			validateConfig) rpc_validate_config ;;
			stats) rpc_stats ;;
			keyGen) rpc_key_gen ;;
			listPresets) rpc_list_presets ;;
			savePreset) rpc_save_preset ;;
			deletePreset) rpc_delete_preset ;;
			writeCompiledConfig) rpc_write_compiled_config ;;
			readCompiledConfig) rpc_read_compiled_config ;;
			readLog) rpc_read_log ;;
			serviceAction) rpc_service_action ;;
			listCores) rpc_list_cores ;;
			installCore) rpc_install_core ;;
			installStatus) rpc_install_status ;;
			switchCore) rpc_switch_core ;;
			removeCore) rpc_remove_core ;;
			stopConflictingServices) rpc_stop_conflicting_services ;;
		esac
		;;
esac
