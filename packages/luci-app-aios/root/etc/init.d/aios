#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1
EXTRA_COMMANDS="start_manual reload_firewall"
EXTRA_HELP="	start_manual	Start AIOS manually even when boot auto-start (enabled) is 0
	reload_firewall	Re-apply AIOS firewall rules without restarting core"

NAME=aios
RUNTIME_DIR=/var/etc/aios
PERSIST_DIR=/etc/aios
CONFIG_FILE="${RUNTIME_DIR}/config.json"
PRECOMPILED_FILE="${PERSIST_DIR}/compiled.json"
ACTIVE_FLAG="${RUNTIME_DIR}/aios_active"
ROUTE_STATE_FILE="${RUNTIME_DIR}/last_route_state"
DNSMASQ_FILES_STATE="${RUNTIME_DIR}/dnsmasq_files"
PID_FILE="/var/run/aios.main.pid"

_log() {
	local level="$1"; shift
	logger -st "aios[$$]" -p "daemon.${level}" "$*"
}

aios_uci_get() {
	local ret
	ret="$(uci -q get "${NAME}.${1}" 2>/dev/null)"
	echo "${ret:-$2}"
}

is_aios_running() {
	local pid=""
	[ -s "$PID_FILE" ] && pid="$(tr -cd '0-9' < "$PID_FILE" 2>/dev/null || true)"
	[ -n "$pid" ] && [ -d "/proc/${pid}" ]
}

is_service_running() {
	local svc="$1"
	[ -x "/etc/init.d/${svc}" ] || return 1
	if command -v ubus >/dev/null 2>&1; then
		ubus call service list "{\"name\":\"${svc}\"}" 2>/dev/null | grep -q '"running"[[:space:]]*:[[:space:]]*true'
		return $?
	fi
	return 1
}

detect_core_type() {
	local configured="$1"
	local bin="$2"

	if [ "$configured" = "xray" ] || [ "$configured" = "v2ray" ]; then
		echo "$configured"
		return 0
	fi

	local ver
	ver="$("$bin" version 2>/dev/null | head -n 1)"
	case "$ver" in
		*[Xx]ray*) echo "xray" ;;
		*V2Ray*|*v2ray*) echo "v2ray" ;;
		*)
			case "$(basename "$bin")" in
				*xray*) echo "xray" ;;
				*) echo "v2ray" ;;
			esac
			;;
	esac
}

detect_firewall_backend() {
	local configured="$1"
	if [ "$configured" = "nftables" ] || [ "$configured" = "iptables" ] || [ "$configured" = "none" ]; then
		echo "$configured"
		return 0
	fi

	if command -v fw4 >/dev/null 2>&1 && command -v nft >/dev/null 2>&1; then
		echo "nftables"
	elif command -v iptables >/dev/null 2>&1 && command -v ipset >/dev/null 2>&1; then
		echo "iptables"
	else
		echo "none"
	fi
}

preflight_conflict_check() {
	local policy="$1"
	local route_table="$2"
	local tproxy_mark="$3"
	local has_conflict=0

	# Check coexisting procd proxy services (informational / warning)
	local svc
	for svc in xray xray_core v2ray passwall passwall2 openclash homeproxy shadowsocksr sing-box v2raya; do
		if is_service_running "$svc"; then
			_log warning "Coexisting proxy service detected running: ${svc} (ensure ports, fwmark, and route tables do not overlap)"
			has_conflict=1
		fi
	done

	# Check third-party nftables tproxy/redirect tables outside inet aios
	if command -v nft >/dev/null 2>&1; then
		local ext_tbl
		ext_tbl="$(nft list ruleset 2>/dev/null | awk '
			/^table / { tbl=$2 " " $3; in_aios=(tbl == "inet aios"); next }
			!in_aios && /(tproxy (to|ip|ip6)|redirect to :)/ { if (tbl != "" && !seen[tbl]++) print tbl }
		')"
		if [ -n "$ext_tbl" ]; then
			_log warning "Third-party transparent proxy nftables rules detected in: $(echo "$ext_tbl" | tr '\n' ' ')"
			has_conflict=1
		fi
	fi

	# Check ip rule collision on configured route table (BusyBox-safe ERE)
	if { ip rule show 2>/dev/null; ip -6 rule show 2>/dev/null; } | grep -Eq "lookup ${route_table}([[:space:]]|$)"; then
		if [ ! -f "$ACTIVE_FLAG" ]; then
			_log warning "Route table ${route_table} already referenced in ip rule"
			has_conflict=1
		fi
	fi

	if [ "$has_conflict" = "1" ] && [ "$policy" = "block" ]; then
		_log err "Conflict policy is set to 'block'; aborting start."
		return 1
	fi
	return 0
}

generate_config() {
	local custom_file="$1"
	mkdir -p "$RUNTIME_DIR" "$PERSIST_DIR"

	if [ -n "$custom_file" ] && [ -r "$custom_file" ]; then
		cp -f "$custom_file" "$CONFIG_FILE"
		return 0
	fi

	if command -v ucode >/dev/null 2>&1 && [ -f /usr/share/aios/gen_config.uc ]; then
		if /usr/bin/ucode /usr/share/aios/gen_config.uc > "${CONFIG_FILE}.tmp"; then
			mv -f "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
			return 0
		fi
		rm -f "${CONFIG_FILE}.tmp"
		_log err "ucode config generation failed; aborting start (fail-fast)"
		return 1
	fi

	if [ -s "$PRECOMPILED_FILE" ]; then
		cp -f "$PRECOMPILED_FILE" "$CONFIG_FILE"
		return 0
	fi

	_log err "No valid configuration generated (neither ucode nor ${PRECOMPILED_FILE} available)"
	return 1
}

setup_dnsmasq_instance() {
	local inst="$1"
	local custom_dir="" dir="" target=""
	if [ -n "$inst" ]; then
		custom_dir="$(uci -q get "dhcp.${inst}.confdir" 2>/dev/null || true)"
		custom_dir="${custom_dir%%,*}"
	fi
	if [ -n "$custom_dir" ] && [ "${custom_dir#/}" != "$custom_dir" ]; then
		dir="$custom_dir"
	elif [ -n "$inst" ] && [ -f /etc/init.d/dnsmasq ] && ! grep -q 'dnsmasq\${cfg' /etc/init.d/dnsmasq 2>/dev/null; then
		dir="/tmp/dnsmasq.d"
	else
		dir="/tmp/dnsmasq.${inst:+"${inst}."}d"
	fi
	mkdir -p "$dir"
	target="${dir}/aios.conf"
	if command -v utpl >/dev/null 2>&1 && [ -f /usr/share/aios/dnsmasq.ut ]; then
		/usr/bin/utpl /usr/share/aios/dnsmasq.ut > "$target"
	else
		local port_start port_count i end_port
		port_start="$(aios_uci_get main_tproxy.dnsmasq_port_start 5350)"
		port_count="$(aios_uci_get main_tproxy.dnsmasq_port_count 3)"
		end_port=$((port_start + port_count))
		{
			echo "# Generated by luci-app-aios"
			echo "strict-order"
			echo "server=/#/127.0.0.1#${port_start}"
			i="$port_start"
			while [ "$i" -lt "$end_port" ]; do
				echo "server=127.0.0.1#${i}"
				i="$((i + 1))"
			done
			echo "bogus-nxdomain=127.127.127.127"
			echo "bogus-nxdomain=100::6c62:636f:656b:2164"
		} > "$target"
	fi
	printf '%s\n' "$target" >> "$DNSMASQ_FILES_STATE"
}

setup_dnsmasq() {
	[ "$(aios_uci_get main_tproxy.dnsmasq_enabled 0)" = "1" ] || return 0
	mkdir -p "$RUNTIME_DIR"
	rm -f "$DNSMASQ_FILES_STATE"
	local mode
	mode="$(aios_uci_get main_tproxy.dnsmasq_integration_mode global)"
	if [ "$mode" = "per_instance" ]; then
		local inst
		for inst in $(uci -q get "${NAME}.main_tproxy.dnsmasq_instances"); do
			setup_dnsmasq_instance "$inst"
		done
	else
		config_load dhcp
		setup_dnsmasq_instance ""
		config_foreach setup_dnsmasq_instance dnsmasq
		config_load "$NAME"
	fi
	# dnsmasq does not reload --conf-dir on SIGHUP; restart is required to apply fragments
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

flush_dnsmasq() {
	local changed=0 f
	if [ -s "$DNSMASQ_FILES_STATE" ]; then
		while IFS= read -r f; do
			if [ -n "$f" ] && [ -f "$f" ]; then
				rm -f "$f"
				changed=1
			fi
		done < "$DNSMASQ_FILES_STATE"
		rm -f "$DNSMASQ_FILES_STATE"
	fi
	for f in /tmp/dnsmasq.d/aios.conf /tmp/dnsmasq.*.d/aios.conf; do
		if [ -f "$f" ]; then
			rm -f "$f"
			changed=1
		fi
	done
	if [ "$changed" = "1" ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
	fi
}

flush_route_pair() {
	local mark="$1" table="$2"
	[ -n "$mark" ] && [ -n "$table" ] || return 0
	ip rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
	ip route del local default dev lo table "$table" 2>/dev/null || true
	ip -6 rule del fwmark "$mark" lookup "$table" 2>/dev/null || true
	ip -6 route del local default dev lo table "$table" 2>/dev/null || true
}

setup_policy_routing() {
	local mark="$1"
	local table="$2"
	flush_policy_routing "$mark" "$table"
	mkdir -p "$RUNTIME_DIR" || return 1
	printf '%s %s\n' "$mark" "$table" > "$ROUTE_STATE_FILE" || return 1
	if ! ip rule add fwmark "$mark" lookup "$table" || ! ip route add local default dev lo table "$table"; then
		flush_policy_routing "$mark" "$table"
		return 1
	fi
	ip -6 rule add fwmark "$mark" lookup "$table" 2>/dev/null || true
	ip -6 route add local default dev lo table "$table" 2>/dev/null || true
	return 0
}

flush_policy_routing() {
	local mark="$1"
	local table="$2"
	flush_route_pair "$mark" "$table"
	if [ -s "$ROUTE_STATE_FILE" ]; then
		local prev_mark prev_table
		read -r prev_mark prev_table < "$ROUTE_STATE_FILE" 2>/dev/null || true
		flush_route_pair "$prev_mark" "$prev_table"
		rm -f "$ROUTE_STATE_FILE"
	fi
}

setup_firewall() {
	[ "$(aios_uci_get main_tproxy.enabled 0)" = "1" ] || return 0

	local backend mark table mode nft_file
	backend="$(detect_firewall_backend "$(aios_uci_get main_tproxy.firewall_backend auto)")"
	mode="$(aios_uci_get main_tproxy.tproxy_mode tproxy)"
	mark="$(aios_uci_get main_tproxy.tproxy_mark 0x3a01)"
	table="$(aios_uci_get main_tproxy.route_table 166)"
	nft_file="${RUNTIME_DIR}/fw4_01_aios.nft"

	case "$backend" in
		nftables)
			mkdir -p "$RUNTIME_DIR"
			if [ "$mode" != "redirect" ]; then
				setup_policy_routing "$mark" "$table" || return 1
			fi
			_log info "Applying isolated nftables table 'inet aios' (${mode})..."
			if ! /usr/bin/utpl /usr/share/aios/firewall/fw4_nft.ut > "${nft_file}.tmp"; then
				rm -f "${nft_file}.tmp"
				_log err "Failed to render nftables ruleset from fw4_nft.ut"
				[ "$mode" != "redirect" ] && flush_policy_routing "$mark" "$table"
				return 1
			fi
			if [ ! -s "${nft_file}.tmp" ] || ! grep -q 'table inet aios' "${nft_file}.tmp"; then
				rm -f "${nft_file}.tmp"
				_log err "Rendered nftables ruleset is empty or missing table inet aios"
				[ "$mode" != "redirect" ] && flush_policy_routing "$mark" "$table"
				return 1
			fi
			mv -f "${nft_file}.tmp" "$nft_file"
			nft delete table inet aios 2>/dev/null || true
			if ! nft -f "$nft_file"; then
				_log err "Failed to apply nftables ruleset ${nft_file}"
				[ "$mode" != "redirect" ] && flush_policy_routing "$mark" "$table"
				return 1
			fi
			if command -v ucode >/dev/null 2>&1 && [ -x /usr/share/aios/firewall/gateway.uc ]; then
				/usr/bin/ucode /usr/share/aios/firewall/gateway.uc >/dev/null 2>&1 || true
			fi
			;;
		iptables)
			_log info "Applying isolated iptables/ipset AIOS_* chains..."
			/usr/share/aios/firewall/fw3_ipt.sh start || return 1
			;;
		none)
			_log info "Firewall backend set to 'none'; skipping transparent proxy rules."
			;;
	esac
}

flush_firewall() {
	local mark table
	mark="$(aios_uci_get main_tproxy.tproxy_mark 0x3a01)"
	table="$(aios_uci_get main_tproxy.route_table 166)"

	flush_policy_routing "$mark" "$table"

	if command -v nft >/dev/null 2>&1; then
		nft delete table inet aios 2>/dev/null || true
	fi
	rm -f "${RUNTIME_DIR}"/fw4_*.nft

	if [ -x /usr/share/aios/firewall/fw3_ipt.sh ] && command -v iptables >/dev/null 2>&1; then
		/usr/share/aios/firewall/fw3_ipt.sh stop >/dev/null 2>&1 || true
	fi
}

boot() {
	mkdir -p "$RUNTIME_DIR"
	start "$@"
}

start_manual() {
	FORCE_START=1 start "$@"
}

reload_firewall() {
	[ -f "$ACTIVE_FLAG" ] || return 0
	if [ "${1:-}" = "trigger" ]; then
		local backend
		backend="$(detect_firewall_backend "$(aios_uci_get main_tproxy.firewall_backend auto)")"
		[ "$backend" = "iptables" ] || return 0
	fi
	flush_firewall
	setup_firewall
}

start_service() {
	mkdir -p "$RUNTIME_DIR"
	config_load "$NAME"

	local enabled
	enabled="$(aios_uci_get main.enabled 0)"
	if [ "$enabled" != "1" ] && [ "${FORCE_START:-0}" != "1" ]; then
		if is_aios_running || [ -f "$ACTIVE_FLAG" ]; then
			# Avoid submitting an empty instance set to procd while running manually
			_log info "AIOS is already running manually; skipping disabled auto-start."
			exit 0
		fi
		_log info "AIOS boot auto-start is disabled (enabled=0). Use start_manual to start manually."
		return 0
	fi

	local core_bin core_type v2ray_format asset_location geoloader go_memlimit
	local rlimit_nofile rlimit_data custom_file conflict_policy route_table tproxy_mark
	local configured_type cands fallback_bin
	configured_type="$(aios_uci_get main.core_type auto)"
	core_bin="$(aios_uci_get main.core_bin '')"
	if [ -z "$core_bin" ]; then
		case "$configured_type" in
			v2ray)
				cands="/usr/bin/aios-v2ray /usr/bin/v2ray /usr/bin/aios-xray /usr/bin/xray"
				fallback_bin="/usr/bin/aios-v2ray"
				;;
			xray)
				cands="/usr/bin/aios-xray /usr/bin/xray /usr/bin/aios-v2ray /usr/bin/v2ray"
				fallback_bin="/usr/bin/aios-xray"
				;;
			*)
				cands="/usr/bin/aios-xray /usr/bin/aios-v2ray /usr/bin/xray /usr/bin/v2ray"
				fallback_bin="/usr/bin/aios-xray"
				;;
		esac
		local cand
		for cand in $cands; do
			if [ -x "$cand" ]; then
				core_bin="$cand"
				break
			fi
		done
		core_bin="${core_bin:-$fallback_bin}"
	fi
	if [ ! -x "$core_bin" ]; then
		_log err "Core binary not executable: ${core_bin}"
		return 1
	fi

	core_type="$(detect_core_type "$configured_type" "$core_bin")"
	v2ray_format="$(aios_uci_get main.v2ray_format jsonv4)"
	asset_location="$(aios_uci_get main.asset_location '')"
	if [ -z "$asset_location" ]; then
		local acand
		for acand in /usr/share/aios/geodata /usr/share/xray /usr/share/v2ray; do
			if [ -d "$acand" ]; then
				asset_location="$acand"
				break
			fi
		done
		asset_location="${asset_location:-/usr/share/aios/geodata}"
	fi
	geoloader="$(aios_uci_get main.geoloader memconservative)"
	go_memlimit="$(aios_uci_get main.go_memlimit '')"
	rlimit_nofile="$(aios_uci_get main.rlimit_nofile 102400)"
	rlimit_data="$(aios_uci_get main.rlimit_data '')"
	custom_file="$(aios_uci_get main.config_file '')"
	conflict_policy="$(aios_uci_get main.conflict_policy warn)"
	route_table="$(aios_uci_get main_tproxy.route_table 166)"
	tproxy_mark="$(aios_uci_get main_tproxy.tproxy_mark 0x3a01)"

	preflight_conflict_check "$conflict_policy" "$route_table" "$tproxy_mark" || return 1
	generate_config "$custom_file" || return 1

	# Validate generated configuration before launching (with GeoData asset env)
	if [ "$core_type" = "xray" ]; then
		if ! XRAY_LOCATION_ASSET="$asset_location" "$core_bin" run -test -c "$CONFIG_FILE" >/dev/null 2>&1; then
			_log err "Xray config test failed for ${CONFIG_FILE}"
			return 1
		fi
	else
		if [ "$v2ray_format" = "jsonv5" ]; then
			if ! V2RAY_LOCATION_ASSET="$asset_location" "$core_bin" test -c "$CONFIG_FILE" -format jsonv5 >/dev/null 2>&1; then
				_log err "V2Ray (jsonv5) config test failed for ${CONFIG_FILE}"
				return 1
			fi
		else
			if ! V2RAY_LOCATION_ASSET="$asset_location" "$core_bin" test -c "$CONFIG_FILE" >/dev/null 2>&1; then
				_log err "V2Ray config test failed for ${CONFIG_FILE}"
				return 1
			fi
		fi
	fi

	_log info "Starting AIOS (${core_type}) via ${core_bin}"
	touch "$ACTIVE_FLAG"

	setup_dnsmasq
	if ! setup_firewall; then
		_log err "Failed to apply AIOS firewall rules; rolling back dnsmasq and aborting start."
		flush_dnsmasq
		rm -f "$ACTIVE_FLAG"
		return 1
	fi

	procd_open_instance "main"
	procd_set_param respawn 3600 5 5
	procd_set_param command "$core_bin" run -c "$CONFIG_FILE"
	if [ "$core_type" = "v2ray" ] && [ "$v2ray_format" = "jsonv5" ]; then
		procd_append_param command -format jsonv5
	fi

	if [ "$core_type" = "xray" ]; then
		procd_set_param env "XRAY_LOCATION_ASSET=${asset_location}"
	else
		procd_set_param env "V2RAY_LOCATION_ASSET=${asset_location}" "V2RAY_CONF_GEOLOADER=${geoloader}"
	fi
	if [ -n "$go_memlimit" ]; then
		procd_append_param env "GOMEMLIMIT=${go_memlimit}"
	fi

	if [ -n "$rlimit_nofile" ] && [ -n "$rlimit_data" ]; then
		procd_set_param limits "nofile=${rlimit_nofile} ${rlimit_nofile}" "data=${rlimit_data} ${rlimit_data}"
	elif [ -n "$rlimit_nofile" ]; then
		procd_set_param limits "nofile=${rlimit_nofile} ${rlimit_nofile}"
	elif [ -n "$rlimit_data" ]; then
		procd_set_param limits "data=${rlimit_data} ${rlimit_data}"
	fi

	procd_set_param file "$CONFIG_FILE"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "$PID_FILE"
	procd_close_instance
}

stop_service() {
	rm -f "$ACTIVE_FLAG"
	flush_firewall
	flush_dnsmasq
}

reload_service() {
	local was_active=0 enabled
	[ -f "$ACTIVE_FLAG" ] && was_active=1
	enabled="$(aios_uci_get main.enabled 0)"
	stop
	if [ "$was_active" = "1" ] && [ "$enabled" != "1" ]; then
		FORCE_START=1 start
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	procd_add_config_trigger "config.change" "firewall" /etc/init.d/aios reload_firewall trigger
}
