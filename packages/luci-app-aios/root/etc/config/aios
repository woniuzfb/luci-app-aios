config general 'main'
	option enabled '0'
	option core_type 'auto'
	option core_bin ''
	option target_version 'auto'
	option bins_dir ''
	option v2ray_format 'jsonv4'
	option asset_location ''
	option geoloader 'memconservative'
	option go_memlimit ''
	option rlimit_nofile '102400'
	option rlimit_data ''
	option config_file ''
	option log_level 'warning'
	option access_log 'none'
	option error_log '/var/log/aios-error.log'
	option dns_log '0'
	option mask_address ''
	option stats_enabled '1'
	option api_enabled '1'
	option api_port '18080'
	option metrics_enabled '1'
	option metrics_port '18888'
	option conflict_policy 'warn'
	option custom_configuration_hook ''

config inbound 'socks_local'
	option enabled '1'
	option alias 'Local SOCKS5'
	option tag 'socks-in'
	option listen '127.0.0.1'
	option port '10800'
	option protocol 'socks'
	option socks_auth 'noauth'
	option socks_udp '1'
	option sniffing_enabled '1'
	list sniffing_dest_override 'http'
	list sniffing_dest_override 'tls'
	list sniffing_dest_override 'quic'

config inbound 'http_local'
	option enabled '1'
	option alias 'Local HTTP'
	option tag 'http-in'
	option listen '127.0.0.1'
	option port '10801'
	option protocol 'http'
	option sniffing_enabled '1'
	list sniffing_dest_override 'http'
	list sniffing_dest_override 'tls'

config outbound 'direct_out'
	option enabled '1'
	option alias 'Direct'
	option tag 'direct'
	option protocol 'freedom'
	option domain_strategy 'UseIP'

config outbound 'block_out'
	option enabled '1'
	option alias 'Block'
	option tag 'block'
	option protocol 'blackhole'
	option blackhole_response 'none'

config outbound 'dns_out'
	option enabled '1'
	option alias 'DNS Outbound'
	option tag 'dns-out'
	option protocol 'dns'

config dns 'main_dns'
	option enabled '1'
	option tag 'dns-in'
	option query_strategy 'UseIP'
	option disable_cache '0'
	option disable_fallback '0'
	option disable_fallback_if_match '0'
	option serve_stale '0'
	option enable_parallel_query '0'

config dns_server 'dns_cn'
	option enabled '1'
	option alias 'AliDNS (CN)'
	option address '223.5.5.5'
	option port '53'
	option skip_fallback '1'
	list domains 'geosite:cn'
	list expect_ips 'geoip:cn'

config dns_server 'dns_global'
	option enabled '1'
	option alias 'Cloudflare DNS'
	option address '1.1.1.1'
	option port '53'

config routing 'main_routing'
	option enabled '1'
	option domain_strategy 'IPIfNonMatch'
	option domain_matcher 'hybrid'

config routing_rule 'rule_private'
	option enabled '1'
	option alias 'Direct Private IP'
	option outbound_tag 'direct'
	list ip 'geoip:private'

config routing_rule 'rule_cn_ip'
	option enabled '1'
	option alias 'Direct CN IP'
	option outbound_tag 'direct'
	list ip 'geoip:cn'

config routing_rule 'rule_cn_domain'
	option enabled '1'
	option alias 'Direct CN Domain'
	option outbound_tag 'direct'
	list domain 'geosite:cn'

config routing_rule 'rule_ads'
	option enabled '1'
	option alias 'Block Ads'
	option outbound_tag 'block'
	list domain 'geosite:category-ads-all'

config policy 'main_policy'
	option enabled '1'
	option handshake '4'
	option conn_idle '300'
	option uplink_only '2'
	option downlink_only '5'
	option buffer_size '4'
	option stats_inbound_uplink '1'
	option stats_inbound_downlink '1'
	option stats_outbound_uplink '1'
	option stats_outbound_downlink '1'

config transparent_proxy 'main_tproxy'
	option enabled '0'
	option firewall_backend 'auto'
	option firewall_priority '10'
	option route_table '166'
	option tproxy_mark '0x3a01'
	option dynamic_direct_mark '0x3a02'
	option outbound_mark '0x3a03'
	option dns_mark '0x3a04'
	option ct_direct_mark '0x3a0a'
	option tproxy_mode 'tproxy'
	option tproxy_port_tcp_v4 '12345'
	option tproxy_port_tcp_v6 '12346'
	option tproxy_port_udp_v4 '12347'
	option tproxy_port_udp_v6 '12348'
	option fakedns_enabled '0'
	option fakedns_pool_v4 '198.18.0.0/15'
	option fakedns_pool_v6 '2001:2::/48'
	option fakedns_port_tcp_v4 '12355'
	option fakedns_port_tcp_v6 '12356'
	option fakedns_port_udp_v4 '12357'
	option fakedns_port_udp_v6 '12358'
	option fakedns_ping_response '1'
	option dynamic_direct_enabled '0'
	option dynamic_direct_timeout '1800'
	option dnsmasq_enabled '0'
	option dnsmasq_integration_mode 'global'
	option dnsmasq_port_start '5350'
	option dnsmasq_port_count '3'
	option default_port_policy 'forwarded'
	list tproxy_ifaces_v4 'br-lan'
	list tproxy_ifaces_v6 'br-lan'
